---
// Custom Starlight SiteTitle: links back to the marketing landing page.
---

<a href="/" class="wg-site-title" aria-label="walletgenerator.dev home">
  <svg class="wg-mark" viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="8" fill="#14b8a6" />
    <rect x="6" y="8" width="20" height="16" rx="3.4" fill="#0a0b0f" />
    <rect x="6" y="12" width="20" height="1.7" fill="#14b8a6" />
    <circle cx="21" cy="18.6" r="2" fill="#14b8a6" />
  </svg>
  <span class="wg-name">walletgenerator<span class="wg-tld">.dev</span></span>
</a>

<style>
  .wg-site-title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .wg-mark {
    width: 1.6rem;
    height: 1.6rem;
    flex-shrink: 0;
  }
  .wg-tld {
    color: var(--sl-color-accent-high);
  }
  @media (max-width: 30rem) {
    .wg-name {
      display: none;
    }
  }
</style>
