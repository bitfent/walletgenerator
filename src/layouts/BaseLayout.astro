---
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "walletgenerator.dev — Generate developer wallets in seconds",
  description = "Batch-create wallet sets for EVM, Solana, Stellar, XRP Ledger, and Bitcoin. Get seed phrases, private keys, addresses, and exports for .env, JSON, CSV, Hardhat, and Foundry. Runs locally in your browser.",
} = Astro.props;

const nav = [
  { href: "/", label: "Generator" },
  { href: "/supported-chains", label: "Chains" },
  { href: "/export-formats", label: "Exports" },
  { href: "/security", label: "Security" },
  { href: "/getting-started", label: "Docs" },
];

const path = Astro.url.pathname;
const year = new Date().getFullYear();
const repo = "https://github.com/bitfent/walletgenerator";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="/og-image.png" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="sticky top-0 z-20 border-b border-ink-800 bg-ink-950/80 backdrop-blur">
      <div class="container-page flex h-16 items-center justify-between">
        <a href="/" class="flex items-center gap-2 font-semibold text-white">
          <svg class="h-7 w-7 shrink-0" viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="8" fill="#14b8a6"></rect>
            <rect x="6" y="8" width="20" height="16" rx="3.4" fill="#0a0b0f"></rect>
            <rect x="6" y="12" width="20" height="1.7" fill="#14b8a6"></rect>
            <circle cx="21" cy="18.6" r="2" fill="#14b8a6"></circle>
          </svg>
          <span>walletgenerator<span class="text-accent-400">.dev</span></span>
        </a>
        <nav class="hidden items-center gap-1 md:flex">
          {
            nav.map((item) => {
              const active = item.href === "/" ? path === "/" : path.startsWith(item.href);
              return (
                <a
                  href={item.href}
                  class={`rounded-md px-3 py-1.5 text-sm transition-colors ${
                    active ? "text-white" : "text-slate-400 hover:text-white"
                  }`}
                >
                  {item.label}
                </a>
              );
            })
          }
          <a href={repo} class="btn-ghost ml-2" rel="noopener" target="_blank">GitHub</a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-ink-800 bg-ink-950">
      <div class="container-page flex flex-col gap-6 py-10 md:flex-row md:justify-between">
        <div class="max-w-sm">
          <div class="font-semibold text-white">
            walletgenerator<span class="text-accent-400">.dev</span>
          </div>
          <p class="mt-2 text-sm text-slate-400">
            Open-source, browser-only developer wallet generator. Development and testing use
            only — do not store meaningful mainnet funds.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-8 text-sm sm:grid-cols-3">
          <div class="space-y-2">
            <div class="font-medium text-slate-300">Product</div>
            <a href="/" class="block text-slate-400 hover:text-white">Generator</a>
            <a href="/supported-chains" class="block text-slate-400 hover:text-white">Chains</a>
            <a href="/export-formats" class="block text-slate-400 hover:text-white">Exports</a>
            <a href="/security" class="block text-slate-400 hover:text-white">Security</a>
          </div>
          <div class="space-y-2">
            <div class="font-medium text-slate-300">Docs</div>
            <a href="/getting-started" class="block text-slate-400 hover:text-white"
              >Getting started</a
            >
            <a href="/guides/hardhat" class="block text-slate-400 hover:text-white">Hardhat</a>
            <a href="/guides/foundry" class="block text-slate-400 hover:text-white">Foundry</a>
            <a href="/derivation-paths" class="block text-slate-400 hover:text-white"
              >Derivation paths</a
            >
          </div>
          <div class="space-y-2">
            <div class="font-medium text-slate-300">Open source</div>
            <a href={repo} class="block text-slate-400 hover:text-white" rel="noopener"
              >GitHub</a
            >
            <a href="/security" class="block text-slate-400 hover:text-white">Security model</a>
          </div>
        </div>
      </div>
      <div class="container-page border-t border-ink-800 py-4 text-xs text-slate-500">
        © {year} walletgenerator.dev · MIT licensed · Wallets generated locally in your browser.
      </div>
    </footer>
  </body>
</html>
